{
  "name": "pi-optchat",
  "version": "0.11.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./durable": "./src/durable/index.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jonaslsaa/pi-optchat/main/docs/banner.jpg"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --import ./test/support.ts --test test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.2",
    "@earendil-works/pi-ai": ">=1.2",
    "@earendil-works/pi-coding-agent": ">=1.2",
    "@earendil-works/pi-durable": "~1.4.0",
    "@earendil-works/pi-tui": ">=1.2",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
